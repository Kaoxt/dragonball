{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dregonball",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-07",
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": ["/api/*"] },
  "durable_objects": { "bindings": [{ "name": "ROOMS", "class_name": "GameRoom" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["GameRoom"] }],
  "ratelimits": [{ "name": "ROOM_LIMITER", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } }],
  "observability": { "enabled": false }
}
