/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  X-Frame-Options: DENY
  Content-Security-Policy: default-src 'self'; script-src 'self' https://challenges.cloudflare.com; frame-src https://challenges.cloudflare.com; style-src 'self' 'sha256-cEmr0VsedmBV/Cwb0ugLY+plBDdLL8VmET8e8VUkpGQ='; img-src 'self' https:; connect-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'self'

# Briefly reuse branding assets during navigation; artwork updates expire quickly.
/assets/*
  Cache-Control: public, max-age=300, stale-while-revalidate=60
